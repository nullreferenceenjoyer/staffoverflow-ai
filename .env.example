# Скопируйте в .env и замените значения, помеченные «замените».

# --- База данных ---
POSTGRES_DB=hr_edu
POSTGRES_USER=hr
POSTGRES_PASSWORD=замените-на-длинный-пароль

# --- Приложение ---
APP_PORT=8080
# Ключ подписи токенов: openssl rand -hex 32
SECRET_KEY=замените-на-случайную-строку
# Соль для обезличивания ФИО. Задаётся один раз: после смены идентификаторы
# сотрудников из старых и новых выгрузок перестанут совпадать.
PII_HASH_SALT=замените-на-другую-случайную-строку
ADMIN_EMAIL=admin@example.ru
ADMIN_PASSWORD=замените-пароль-администратора
# true — при первом запуске создать демонстрационные учреждения и пользователей
SEED_DEMO_DATA=true
# Свой профиль демо-данных вместо seed/demo.json (см. seed/README.md)
# SEED_FILE=/seed/local.json
BACKUP_KEEP_DAYS=14

# --- Локальная модель ---
# Вариант 1. Модель в Docker (llama.cpp): положите .gguf в папку models/
# и раскомментируйте две строки ниже.
#COMPOSE_PROFILES=llm
#LLM_BASE_URL=http://llm:8080/v1
# Если в models/ несколько файлов, укажите нужный:
#LLM_MODEL_FILE=Qwen3-4B-Q4_K_M.gguf
LLM_CONTEXT=8192
#LLM_THREADS=6

# Вариант 2. Модель запущена на хосте в LM Studio (Developer → Start server).
# LLM_MODEL — идентификатор из GET http://localhost:1234/v1/models
#LLM_BASE_URL=http://host.docker.internal:1234/v1
#LLM_MODEL=qwen3-8b

LLM_MAX_TOKENS=900
LLM_TEMPERATURE=0.2
LLM_TIMEOUT_S=300
# Отключает «размышления» у Qwen3 и похожих моделей — на CPU это экономит минуты
LLM_DISABLE_THINKING=true

# --- Облачная модель (необязательно) ---
# Используется только для текстов без персональных данных. В закрытом контуре не включать.
# Подходит любой OpenAI-совместимый сервис, например YandexGPT:
#   CLOUD_LLM_BASE_URL=https://llm.api.cloud.yandex.net/v1
#   CLOUD_LLM_MODEL=gpt://<id каталога>/yandexgpt/latest
CLOUD_LLM_ENABLED=false
CLOUD_LLM_BASE_URL=
CLOUD_LLM_MODEL=
CLOUD_LLM_API_KEY=

# --- Поиск по базе знаний ---
# hashing — встроенный, без модели; openai — внешний сервер эмбеддингов (/v1/embeddings)
EMBEDDING_BACKEND=hashing
EMBEDDING_BASE_URL=
EMBEDDING_MODEL=

# --- Боты (необязательно) ---
# MAX: токен бота из кабинета разработчика. Telegram: токен от @BotFather.
MAX_BOT_TOKEN=
TELEGRAM_BOT_TOKEN=

# --- Анализ загрузки и заявки ---
# Корпуса ближе этого расстояния (в метрах) считаются одной площадкой
SITE_RADIUS_M=300
# За сколько часов до срока напоминать исполнителю заявки
REQUEST_WARN_HOURS=24
# Через сколько дней выполненная заявка закрывается сама, если заявитель молчит
REQUEST_AUTOCLOSE_DAYS=3
